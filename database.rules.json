{
  "rules": {
    ".read": false,
    ".write": false,
    "usuarios": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('rol').val() === 'admin' && root.child('usuarios').child(auth.uid).child('activo').val() === true",
      "$uid": {
        ".read": "auth != null && ((auth.uid === $uid) || (root.child('usuarios').child(auth.uid).child('rol').val() === 'admin' && root.child('usuarios').child(auth.uid).child('activo').val() === true))",
        ".write": "auth != null && ((root.child('usuarios').child(auth.uid).child('rol').val() === 'admin' && root.child('usuarios').child(auth.uid).child('activo').val() === true) || (auth.uid === $uid && !data.exists() && auth.token.email_verified === true && newData.child('email').val() === auth.token.email && ((auth.token.email.toLowerCase() === 'dannytrujillo8307@gmail.com' && newData.child('rol').val() === 'admin' && newData.child('activo').val() === true) || (auth.token.email.toLowerCase() !== 'dannytrujillo8307@gmail.com' && newData.child('rol').val() === 'pendiente' && newData.child('activo').val() === false))))",
        ".validate": "!newData.exists() || (newData.hasChildren(['email', 'rol', 'activo']) && newData.child('email').isString() && (newData.child('rol').val() === 'admin' || newData.child('rol').val() === 'vendedor' || newData.child('rol').val() === 'pendiente') && newData.child('activo').isBoolean())"
      }
    },
    "rifas": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('activo').val() === true && (root.child('usuarios').child(auth.uid).child('rol').val() === 'admin' || root.child('usuarios').child(auth.uid).child('rol').val() === 'vendedor')",
      "$raffleId": {
        ".read": "auth != null && (root.child('usuarios').child(auth.uid).child('activo').val() === true) && (root.child('usuarios').child(auth.uid).child('rol').val() === 'admin' || root.child('usuarios').child(auth.uid).child('rol').val() === 'vendedor')",
        "config": {
          ".write": "auth != null && root.child('usuarios').child(auth.uid).child('rol').val() === 'admin' && root.child('usuarios').child(auth.uid).child('activo').val() === true"
        },
        "meta": {
          ".write": "auth != null && root.child('usuarios').child(auth.uid).child('rol').val() === 'admin' && root.child('usuarios').child(auth.uid).child('activo').val() === true"
        },
        "ventas": {
          "$saleId": {
            ".write": "auth != null && root.child('usuarios').child(auth.uid).child('activo').val() === true && (root.child('usuarios').child(auth.uid).child('rol').val() === 'admin' || root.child('usuarios').child(auth.uid).child('rol').val() === 'vendedor') && root.child('rifas').child($raffleId).child('meta').child('estado').val() === 'activa'"
          }
        }
      }
    },
    "configRifa": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('rol').val() === 'admin' && root.child('usuarios').child(auth.uid).child('activo').val() === true",
      ".write": false
    },
    "ventasRifa": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('rol').val() === 'admin' && root.child('usuarios').child(auth.uid).child('activo').val() === true",
      ".write": false
    }
  }
}

